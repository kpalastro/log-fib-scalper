# ═══════════════════════════════════════════════════════════════
# GATE.IO API CREDENTIALS
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to git!

# Gate.io API Key (from https://www.gate.io/settings/api)
GATE_API_KEY=your_api_key_here

# Gate.io API Secret (from https://www.gate.io/settings/api)
GATE_API_SECRET=your_api_secret_here

# ═══════════════════════════════════════════════════════════════
# CRYPTO INSTRUMENT SELECTION
# ═══════════════════════════════════════════════════════════════
# Choose which crypto to trade:
#   BTCUSDT_5MIN  - Bitcoin 5-minute (⭐ 94.59% win rate, +$29K P&L)
#   ETHUSDT_5MIN  - Ethereum 5-minute (optimization pending)
#   XRPUSDT_5MIN  - Ripple 5-minute (optimization pending)
#   Add more as you optimize them!

CRYPTO_INSTRUMENT=BTCUSDT_5MIN

# Trading size (% of USDT balance per trade)
CRYPTO_POSITION_SIZE_PCT=0.02

# Max daily trades
CRYPTO_MAX_DAILY_TRADES=50
