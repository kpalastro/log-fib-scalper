# ═══════════════════════════════════════════════════════════════
# IG MARKETS API CREDENTIALS
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to git!

# IG Markets API Key (from https://www.ig.com/uk/trading-api)
IG_API_KEY=your_api_key_here

# IG Username (your account username)
IG_USERNAME=your_username

# IG Password (your account password)
IG_PASSWORD=your_password

# IG Account ID (found in your account settings)
IG_ACCOUNT_ID=your_account_id

# Use Demo Account? (true/false) - RECOMMENDED FOR TESTING!
IG_DEMO=true

# ═══════════════════════════════════════════════════════════════
# INSTRUMENT SELECTION
# ═══════════════════════════════════════════════════════════════
# Choose which instrument/timeframe to trade:
#   XAUUSD_5MIN  - Gold 5-minute (⭐ RECOMMENDED - 98.43% win rate)
#   XAUUSD_1MIN  - Gold 1-minute (93.48% win rate)
#   XAGUSD_1MIN  - Silver 1-minute (95.25% win rate)

IG_INSTRUMENT=XAUUSD_5MIN

# IG Instrument Epic (auto-set based on IG_INSTRUMENT, but can override)
# Common epics:
#   IX.D.SILVER.IPV - XAGUSD (Silver)
#   IX.D.GOLD.IPV   - XAUUSD (Gold)
# IG_INSTRUMENT_EPIC=IX.D.GOLD.IPV
