# ═══════════════════════════════════════════════════════════════
# LOG-FIB SCALPER - .gitignore
# ═══════════════════════════════════════════════════════════════

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
ENV/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Data (DO NOT commit large CSV files)
data/*.csv
data/*.ddb
data/*.wal

# Logs
*.log
logs/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Jupyter Notebooks
.ipynb_checkpoints/

# Environment Variables (API Keys, Secrets)
# Covers all .env variants: .env, .env.local, .env.neo, .env.zerodha, .env.production, etc.
# Only .env.example files are tracked (placeholders only).
.env
.env.local
.env.*.local
.env.*
!.env.example
!**/.env.example

# Credentials & sensitive configs
config.production.py
secrets.py
*credentials*
*creds*.json
*.pem
*.key
*.p12
*.pfx

# IDE / editor credential caches
.cursor/
.aider*

# Model Checkpoints / Large Files
*.pth
*.pt
*.onnx
*.h5
models/

# Temporary Files
tmp/
temp/
*.tmp

# OS Files
Thumbs.db
.DS_Store
